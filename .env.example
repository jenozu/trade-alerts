# ProjectX credentials. Keep real values only in .env; never commit them.
PROJECTX_USERNAME=
PROJECTX_API_KEY=

# Optional ProjectX/runtime settings.
PROJECTX_ACCOUNT_ID=
PROJECTX_CONTRACT_ID=
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_SYMBOL=MNQ
PROJECTX_LIVE=false
PROJECTX_HISTORY_DAYS=30
PROJECTX_CHUNK_DAYS=10
PROJECTX_REQUEST_DELAY_SECONDS=0.8
PROJECTX_MAX_STALE_MINUTES=5

APP_TIMEZONE=America/New_York
DATA_DIR=/docker/trade-alerts/data
LOG_LEVEL=INFO

# Optional transport for deterministic Phase 9 alert payloads.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set only when deploy.sh should restart already-installed Phase 10 timers.
TRADE_ALERTS_RESTART_SERVICES=0

# Backward compatibility: an existing VPS may use TOPSTEP_USERNAME and
# TOPSTEP_API_KEY instead of the preferred PROJECTX names. The client supports
# both; do not populate both sets unless they contain the same credentials.
TOPSTEP_USERNAME=
TOPSTEP_API_KEY=
